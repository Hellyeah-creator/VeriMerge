# VeriMerge Environment Configuration

# Database
# Default: SQLite (verimerge.db) - works immediately out-of-the-box
DATABASE_URL=sqlite:///./verimerge.db
# PostgreSQL option:
# DATABASE_URL=postgresql://verimerge:verimerge_password@localhost:5432/verimerge_db

# AI Provider Configuration (OpenAI / Gemini / Any OpenAI-Compatible endpoint)
# If left empty, VeriMerge seamlessly runs its built-in zero-hallucination heuristic reasoning engine!
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Zero-Trust Governance Thresholds
AUTO_RESOLVE_THRESHOLD=90.0
HUMAN_REVIEW_THRESHOLD=70.0
ENTITY_MATCH_THRESHOLD=78.0
